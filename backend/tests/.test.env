# Settings for `poe test`. Loaded by tests/conftest.py and takes priority over backend/.env.
ENVIRONMENT=test
LOG_LEVEL=WARNING
# Each test run creates (and later drops) its own tierforge_test_<random> database
# on this server; only the user, password, host and port here are used.
DATABASE_URL=postgres:postgres@localhost:5432/tierforge_test
DATABASE_ECHO_SQL=false
ENRICHMENT_BASE_URL=http://localhost:8000
AWS_ENDPOINT_URL=http://localhost:4566
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
SQS_ENRICHMENT_QUEUE_URL=http://sqs.us-east-1.localhost.localstack.cloud:4566/000000000000/tierforge-enrichment-test
