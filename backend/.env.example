# Copy to .env (inside backend/) and adjust:  cp .env.example .env

APP_NAME=tierforge
ENVIRONMENT=development
LOG_LEVEL=INFO

# API server (used by `poe api`)
API_HOST=127.0.0.1
API_PORT=8001

# Postgres as user:password@host:port/database. DBConfig adds the postgresql+asyncpg:// prefix.
DATABASE_URL=postgres:postgres@localhost:5432/tierforge
DATABASE_ECHO_SQL=false

# Enrichment simulator (`poe simulator` listens on SIMULATOR_PORT; the worker calls ENRICHMENT_BASE_URL)
SIMULATOR_PORT=8000
ENRICHMENT_BASE_URL=http://localhost:8000

# AWS. Locally these point at LocalStack (any non-empty credentials work).
# In AWS, leave the endpoint and both keys unset to use the real endpoint and the IAM role.
AWS_ENDPOINT_URL=http://localhost:4566
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# SQS: URL of an existing queue (created by `poe localstack_init` locally, Terraform in AWS).
# 000000000000 is LocalStack's default account ID.
# IAM: the worker's Terraform IAM policy needs sqs:GetQueueAttributes (checked at
# worker startup), sqs:ReceiveMessage and sqs:DeleteMessage; the API needs sqs:SendMessage.
SQS_ENRICHMENT_QUEUE_URL=http://sqs.us-east-1.localhost.localstack.cloud:4566/000000000000/tierforge-enrichment
SQS_WAIT_TIME_SECONDS=20
SQS_MAX_MESSAGES=10

# Health checks
HEALTH_POSTGRES_TIMEOUT_SECONDS=2

# Store CSV uploads (10 MB)
UPLOAD_MAX_SIZE_BYTES=10485760
