# Copy to .env (inside backend/) and adjust:  cp .env.example .env

APP_NAME=tierforge
ENVIRONMENT=development
LOG_LEVEL=INFO

# API server (used by `poe api`)
API_HOST=127.0.0.1
API_PORT=8001
# Origins a browser frontend may call the API from (CORS), comma-separated.
# "*" (the default) allows any origin, e.g. ALLOWED_ORIGINS=http://localhost:5173,https://app.example.com
ALLOWED_ORIGINS=*

# Postgres as user:password@host:port/database. DBConfig adds the postgresql+asyncpg:// prefix.
DATABASE_URL=postgres:postgres@localhost:5432/tierforge
DATABASE_ECHO_SQL=false

# Enrichment simulator (`poe simulator` listens on SIMULATOR_PORT; the worker calls ENRICHMENT_BASE_URL)
SIMULATOR_PORT=8000
ENRICHMENT_BASE_URL=http://localhost:8000
# Per call, from connecting to the last byte; a slower call fails the store.
ENRICHMENT_TIMEOUT_SECONDS=10
# Calls/s across the worker. The API allows 5/s globally and answers 429 above it.
ENRICHMENT_RATE_PER_SECOND=4.5
# Calls in flight at once in one worker (the rate limit still caps calls/s).
ENRICHMENT_CONCURRENCY=8
# Calls per store in total, the first one included; then the store fails.
ENRICHMENT_MAX_ATTEMPTS=5
# Wait before retry n: BASE × 2^(n−1), capped at MAX (≤ 900, SQS's limit), times a random 50-100%.
ENRICHMENT_BACKOFF_BASE_SECONDS=2
ENRICHMENT_BACKOFF_MAX_SECONDS=60
# Wait before retrying a 429 (doesn't use up an attempt).
ENRICHMENT_RATE_LIMITED_DELAY_SECONDS=1
# How long a claimed task belongs to its handler before it can be taken over.
# Must be longer than ENRICHMENT_TIMEOUT_SECONDS and shorter than the queue's visibility timeout (30 s).
ENRICHMENT_LEASE_SECONDS=25
# Failed calls in a row, across one job's stores, that fail the whole job (circuit breaker).
ENRICHMENT_CIRCUIT_BREAKER_THRESHOLD=20

# AWS. Locally these point at LocalStack (any non-empty credentials work).
# In AWS, leave the endpoint and both keys unset to use the real endpoint and the IAM role.
AWS_ENDPOINT_URL=http://localhost:4566
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# SQS: URL of an existing queue (created by `poe localstack_init` locally, Terraform in AWS).
# 000000000000 is LocalStack's default account ID.
# IAM: the worker's Terraform IAM policy needs sqs:GetQueueAttributes (checked at
# worker startup), sqs:ReceiveMessage, sqs:DeleteMessage and sqs:SendMessage (retry
# events); the API needs sqs:SendMessage.
SQS_ENRICHMENT_QUEUE_URL=http://sqs.us-east-1.localhost.localstack.cloud:4566/000000000000/tierforge-enrichment
SQS_WAIT_TIME_SECONDS=20
SQS_MAX_MESSAGES=10
SQS_SEND_CONCURRENCY=10

# Health checks
HEALTH_POSTGRES_TIMEOUT_SECONDS=2

# Store CSV uploads (10 MB)
UPLOAD_MAX_SIZE_BYTES=10485760
